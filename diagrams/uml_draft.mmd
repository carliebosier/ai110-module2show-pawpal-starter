classDiagram
    class Owner {
        +str owner_id
        +str name
        +List~Pet~ pets
        +int available_time_minutes
        +add_pet(pet) None
        +get_all_tasks() List~Task~
    }
 
    class Pet {
        +str pet_id
        +str name
        +str species
        +List~Task~ tasks
        +add_task(task) None
        +get_tasks() List~Task~
    }
 
    class Task {
        +str task_id
        +str description
        +datetime time
        +str frequency
        +bool is_completed
        +mark_complete() None
        +is_due(current_time) bool
    }
 
    class Scheduler {
        +generate_plan(owner, current_time) dict
        +_sort_by_priority(tasks) List~Task~
        +_fits(task, remaining_minutes) bool
    }
 
    Owner "1" *-- "many" Pet : owns
    Pet "1" *-- "many" Task : has care tasks
    Scheduler ..> Owner : retrieves tasks from
    Scheduler ..> Task : reads and sorts
 